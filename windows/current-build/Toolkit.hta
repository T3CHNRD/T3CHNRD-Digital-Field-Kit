<!DOCTYPE html>
<html>
<head>
<title>T3CHNRD Digital Field Kit</title>
<HTA:APPLICATION
  ID="WMDT"
  APPLICATIONNAME="T3CHNRD Digital Field Kit"
  BORDER="thin"
  BORDERSTYLE="normal"
  CAPTION="yes"
  ICON="Toolkit.ico"
  MAXIMIZEBUTTON="yes"
  MINIMIZEBUTTON="yes"
  SCROLL="no"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="maximize" />
<meta http-equiv="X-UA-Compatible" content="IE=11" />
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<style>
html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden;font-family:Segoe UI,Tahoma,Arial,sans-serif;background:#0f2534;color:#15233b}
*{box-sizing:border-box}
#shell{position:absolute;left:12px;right:12px;top:10px;bottom:10px;border:2px solid #56c7ff;border-radius:15px;overflow:hidden;background:#dce8f1;box-shadow:0 0 18px #168ddd,inset 0 0 0 1px #003c67}
#header{height:190px;position:relative;color:white;background:linear-gradient(#0f587f 0%,#0a4c70 42%,#063852 100%);border-bottom:1px solid #3be4ff;overflow:hidden}
#header:before{content:"";position:absolute;left:0;right:0;top:0;height:90px;background:linear-gradient(rgba(255,255,255,.30),rgba(255,255,255,0));pointer-events:none}
#header:after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:#75d9ff}
#logoOrb{position:absolute;left:38px;top:30px;width:76px;height:76px;border-radius:50%;background:radial-gradient(circle at 35% 28%,#8fdcff,#227fc1 42%,#0a416d 72%);border:2px solid #b9edff;box-shadow:0 0 10px #3dd8ff,inset 0 0 12px rgba(255,255,255,.5)}
#logoOrb .pane{position:absolute;background:linear-gradient(#39a3f0,#1264b9);border:1px solid rgba(255,255,255,.6)}
#logoOrb .p1{left:16px;top:19px;width:20px;height:18px}.p2{left:39px;top:16px;width:20px;height:21px}.p3{left:15px;top:41px;width:21px;height:19px}.p4{left:39px;top:41px;width:21px;height:18px}
#title{position:absolute;left:132px;top:34px;font-size:32px;font-weight:600;text-shadow:0 2px 2px #00263e;letter-spacing:.2px}
#tagline{position:absolute;left:134px;top:82px;font-size:15px;color:#d9f1ff;letter-spacing:.4px}
#brandNote{position:absolute;right:34px;top:32px;text-align:right;font-size:17px;color:#e8fbff}.small{font-size:12px;color:#b8d9ea;font-style:italic}
#platformSwitch{position:absolute;right:32px;top:92px;height:34px;background:#071720;border:1px solid #55788c;border-radius:17px;padding:2px;box-shadow:inset 0 1px 4px #000}
.plat{display:inline-block;min-width:92px;height:28px;line-height:28px;text-align:center;border-radius:14px;color:#bdd3df;font-size:12px;font-weight:700;cursor:pointer}.plat.active{background:linear-gradient(#b9e743,#75a817);color:#142400;box-shadow:inset 0 1px rgba(255,255,255,.5)}
#tabs{position:absolute;left:0;right:0;top:132px;height:58px;background:linear-gradient(#091722,#02080d);padding-left:16px;border-top:1px solid rgba(124,211,255,.45);border-bottom:1px solid #355566;box-shadow:inset 0 1px rgba(255,255,255,.08)}
.tab{display:inline-block;vertical-align:top;height:50px;min-width:132px;margin:5px 6px 0 0;padding:12px 22px;text-align:center;color:#eef6fb;font-size:17px;font-weight:700;letter-spacing:.6px;border:1px solid #567080;border-bottom:3px solid #061019;border-radius:9px 9px 0 0;cursor:pointer;background:linear-gradient(#3b4d58 0%,#1f2d35 52%,#111b21 100%);box-shadow:inset 0 1px rgba(255,255,255,.16),0 -1px 5px rgba(0,0,0,.28);text-shadow:0 1px 1px #000}
.tab:hover{background:linear-gradient(#506979,#293a44 55%,#17252c);border-color:#84a8bb}.tab.active{color:#132500;background:linear-gradient(#ddff72 0%,#b1df2e 46%,#78ab13 100%);border-color:#f0ffa1 #c6ef55 #587f08;box-shadow:inset 0 2px rgba(255,255,255,.68),0 0 12px rgba(168,218,55,.62);text-shadow:0 1px rgba(255,255,255,.75)}
#searchWrap{position:absolute;right:28px;top:141px;width:330px;height:38px;border:1px solid #6b91a7;border-radius:10px;background:linear-gradient(#132b39,#07141d);box-shadow:inset 0 1px 5px #000,0 1px rgba(255,255,255,.12);z-index:10}
#search{width:270px;height:35px;background:transparent;border:0;outline:0;color:#e7f7ff;font-size:14px;padding:6px 12px;text-align:left}
#searchIcon{position:absolute;right:11px;top:10px;font-size:10px;font-weight:bold;color:#8fb7cc;letter-spacing:.5px}
#body{position:absolute;left:0;right:0;top:190px;bottom:64px;background:#edf2f5}
#sidebar{position:absolute;left:0;top:0;bottom:0;width:240px;padding:18px 12px;background:linear-gradient(#14334a,#092236);border-right:1px solid #7fa2b7;color:#d7e8f2;overflow:auto}
.nav{height:50px;padding:10px 12px;margin-bottom:4px;border-radius:5px;cursor:pointer;font-size:15px;border:1px solid transparent;border-left:5px solid transparent;line-height:28px}.nav:hover{background:linear-gradient(90deg,#235674,#173d56);border-color:#315f78}.nav.active{background:linear-gradient(90deg,#6f9d24 0%,#315b37 58%,#21423a 100%);border-color:#5a7f4b;border-left-color:#c8f33d;color:white;box-shadow:inset 0 1px rgba(255,255,255,.13),0 0 5px rgba(0,0,0,.18)}
.nav .nicon{display:inline-block;width:28px;height:28px;margin-right:7px;vertical-align:middle}.nav .nicon img{width:24px;height:24px;vertical-align:middle}.nav.sep{margin-top:12px;border-top:1px solid #486276;padding-top:15px;height:62px}
#main{position:absolute;left:240px;right:0;top:0;bottom:0;padding:18px 22px;overflow:auto;background:linear-gradient(#fbfdfe,#e7eef3)}
#pageTitle{font-size:31px;font-weight:700;color:#142b4f;margin-bottom:2px;font-style:italic}#pageSub{color:#52687c;font-size:14px;margin-bottom:18px}
#infoBar{position:absolute;right:24px;top:18px;width:315px;min-height:62px;background:linear-gradient(#f7fcff,#dcecf7);border:1px solid #b9cfde;border-radius:8px;padding:10px 12px 9px 46px;color:#33506c;box-shadow:inset 0 1px white,0 1px 4px rgba(48,85,110,.12);font-size:12px;line-height:1.35}#infoDot{position:absolute;left:12px;top:12px;width:24px;height:24px;border-radius:50%;background:linear-gradient(#55b5e7,#2687c4);color:#fff;font-weight:bold;text-align:center;padding-top:3px;border:1px solid #1873ad}
#cards{padding-top:58px}.card{position:relative;display:inline-block;vertical-align:top;width:31.8%;min-width:285px;height:148px;margin:0 1.1% 14px 0;border:1px solid #adbeca;border-radius:9px;background:linear-gradient(#fff 0%,#f5f7f8 52%,#e9eef1 100%);box-shadow:0 2px 4px rgba(65,93,112,.24),inset 0 1px white;cursor:pointer;overflow:hidden}.card:hover{border-color:#4c9bd0;background:linear-gradient(#fff,#f0f8fd);box-shadow:0 0 0 2px rgba(75,160,220,.16),0 4px 8px rgba(40,82,111,.26)}
.cardIcon{position:absolute;left:18px;top:29px;width:76px;height:76px}.cardIcon img{width:76px;height:76px}.cardText{position:absolute;left:110px;right:26px;top:27px}.cardTitle{font-size:18px;font-weight:700;color:#122452;margin-bottom:8px}.cardDesc{font-size:13px;color:#60738a;line-height:1.35}.cardRisk{position:absolute;right:7px;bottom:6px;font-size:9px;font-weight:bold;color:#69808f;text-transform:uppercase}.cardStar{position:absolute;right:9px;top:6px;font-size:19px;color:#93a6b2;cursor:pointer}.cardStar.on{color:#e0ad10;text-shadow:0 1px white}
#settingsPanel,#runbookPanel,#macPanel{display:none;padding:15px 5px;color:#29425b}#runbookPanel{position:relative;height:calc(100% - 75px)}.settingsBox{max-width:900px;background:white;border:1px solid #b8c9d4;border-radius:9px;padding:18px;box-shadow:0 2px 5px rgba(30,60,80,.16);margin-bottom:14px}.actionBtn{display:inline-block;background:linear-gradient(#4ea2df,#1b6da8);color:#fff;border:1px solid #0d5488;border-radius:5px;padding:10px 16px;margin:5px;cursor:pointer;font-weight:600;box-shadow:inset 0 1px rgba(255,255,255,.45)}.actionBtn.green{background:linear-gradient(#a9da37,#65950d);border-color:#537d08;color:#102106}
#runbookToolbar{height:52px;margin-bottom:10px;padding:5px 6px;background:linear-gradient(#f7fbfd,#e1ebf1);border:1px solid #b8cad5;border-radius:7px;white-space:nowrap}
#runbookToolbar .actionBtn{padding:7px 11px;margin:2px 4px;font-size:12px}
#rbSearch{width:260px;height:31px;margin:2px 5px;padding:4px 9px;border:1px solid #91aabd;border-radius:5px;background:white;color:#23384b}
#rbFile{width:220px;font-size:11px}
.runbookState{padding:8px 12px;background:#edf6fb;border:1px solid #b6cedc;border-radius:7px;margin-bottom:10px;font-size:12px}
.runbookList{width:330px;position:absolute;left:0;top:116px;bottom:0;overflow:auto;border:1px solid #bdcbd4;background:#f7fafc;border-radius:5px}
.rbGroup{padding:8px 10px;background:#173c55;color:white;font-weight:bold;font-size:12px;border-bottom:1px solid #0b2638}
.rbItem{padding:8px 10px 8px 18px;border-bottom:1px solid #d9e2e8;cursor:pointer;font-size:12px;line-height:1.25}.rbItem:hover{background:#e5f4fc}
.runbookViewer{position:absolute;left:345px;right:0;top:116px;bottom:0;background:#fff;border:1px solid #bdcbd4;border-radius:5px;overflow:hidden}.runbookViewer iframe{width:100%;height:100%;border:0}.runbookViewer pre{white-space:pre-wrap;padding:16px;margin:0;height:100%;overflow:auto;font-family:Consolas,monospace;font-size:12px}
.macGrid{max-width:1050px}.macCard{display:inline-block;vertical-align:top;width:31%;min-width:260px;height:120px;margin:0 1.3% 14px 0;background:linear-gradient(#fff,#edf2f5);border:1px solid #b7c6cf;border-radius:9px;padding:14px;box-shadow:0 2px 4px rgba(45,70,85,.16)}.macCard b{font-size:16px;color:#153a55}.macCard span{display:block;margin-top:7px;color:#607686;font-size:12px;line-height:1.35}.planned{display:inline-block;margin-top:8px;color:#7a9714;font-weight:bold;font-size:10px}
#runner{display:none;position:absolute;z-index:700;left:255px;right:16px;bottom:74px;height:285px;background:#111a20;border:1px solid #54819a;border-radius:9px;box-shadow:0 0 18px rgba(0,0,0,.5);color:#dcecf5;overflow:hidden}#runnerHead{height:48px;padding:12px 14px;background:linear-gradient(#254c64,#102c3c);border-bottom:1px solid #4d7a92;font-weight:700}#runnerClose{float:right;cursor:pointer;color:#d9eaf2;font-size:18px}.runnerBtn{float:right;margin-right:14px;padding:4px 10px;border:1px solid #6e8fa0;border-radius:4px;cursor:pointer;font-size:11px;background:#1f3e50}.runnerProgress{position:absolute;left:14px;right:14px;top:54px;height:10px;background:#061017;border:1px solid #37586a;border-radius:5px;overflow:hidden}.runnerProgress div{height:100%;width:0;background:linear-gradient(90deg,#78ad15,#c7ef48);transition:width .3s}#runnerOut{position:absolute;left:14px;right:14px;top:76px;bottom:12px;overflow:auto;white-space:pre-wrap;font:12px Consolas,monospace;background:#071015;border:1px solid #203b49;border-radius:4px;padding:10px;color:#d5e9f1}
#footer{position:absolute;left:0;right:0;bottom:0;height:64px;background:linear-gradient(#0e3b56,#082a3e);border-top:1px solid #64cfff;color:#e9f7ff}#ready{position:absolute;left:22px;top:11px}.readyDot{display:inline-block;width:38px;height:38px;border-radius:50%;background:linear-gradient(#7dd33e,#3f9c1f);border:2px solid #a9ef78;color:white;font-size:12px;font-weight:bold;text-align:center;padding-top:10px;vertical-align:middle}.readyTxt{display:inline-block;vertical-align:middle;margin-left:10px;font-weight:700}.readyTxt span{display:block;font-size:12px;font-weight:normal;color:#c8dce8}#sysInfo{position:absolute;left:38%;top:13px;font-size:13px;color:#d7e7f1;line-height:1.4}#footerRight{position:absolute;right:24px;top:15px;text-align:right;font-size:12px;color:#bfd4e1}
.modalShade{display:none;position:absolute;z-index:900;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,.48)}.modal{position:absolute;left:50%;top:50%;width:520px;margin-left:-260px;margin-top:-145px;background:#f5f7f8;border:1px solid #8ea4b0;border-radius:10px;box-shadow:0 8px 30px #000;color:#25384a;overflow:hidden}.modalHead{padding:12px 16px;background:linear-gradient(#edf9ff,#b9d7e7);font-weight:700;color:#16436a}.modalBody{padding:18px;font-size:14px;line-height:1.45}.modalBtns{text-align:right;padding:10px 16px 16px}.modalBtns button{min-width:100px;padding:7px 12px;margin-left:8px}
</style>
<script src="Assets/tools.js"></script>
<script>
var ROOT='',REPORT='',currentCategory='All Tools',currentTab='tools',currentPlatform='windows',favorites=[],recent=[],pendingTool=null,runnerTimer=null,runnerProc=null,runnerLog='',runnerErr='',runnerManifest='',runnerPct=0,runbookRoot='',runbookIndex=[];
function normalizePath(p){p=decodeURIComponent(p);if(p.charAt(0)=='/'&&p.charAt(2)==':')p=p.substring(1);return p.replace(/\//g,'\\');}
function dirname(p){var i=p.lastIndexOf('\\');return i>=0?p.substring(0,i):p;}
function join(a,b){return a.replace(/[\\]+$/,'')+'\\'+b.replace(/^[\\]+/,'');}
function shell(){return new ActiveXObject('WScript.Shell');}function fso(){return new ActiveXObject('Scripting.FileSystemObject');}
function escPs(s){return String(s).replace(/'/g,"''");}function html(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function statePath(){return shell().ExpandEnvironmentStrings('%LOCALAPPDATA%')+'\\WindowsMasterDiagnosticToolkit\\ui-state.txt';}
function loadState(){try{var fs=fso(),p=statePath();if(!fs.FileExists(p))return;var x=fs.OpenTextFile(p,1);var t=x.ReadAll().split(/\r?\n/);x.Close();favorites=(t[0]||'').split('|');recent=(t[1]||'').split('|');favorites=cleanArray(favorites);recent=cleanArray(recent);}catch(e){}}
function cleanArray(a){var o=[];for(var i=0;i<a.length;i++)if(a[i])o.push(a[i]);return o;}
function saveState(){try{var fs=fso(),p=statePath(),d=dirname(p);ensureFolder(d);var x=fs.CreateTextFile(p,true);x.WriteLine(favorites.join('|'));x.WriteLine(recent.join('|'));x.Close();}catch(e){}}
function ensureFolder(p){var fs=fso();if(fs.FolderExists(p))return;var parent=dirname(p);if(parent&&parent!==p&&!fs.FolderExists(parent))ensureFolder(parent);try{fs.CreateFolder(p);}catch(e){}}
function has(a,v){for(var i=0;i<a.length;i++)if(a[i]===v)return true;return false;}function removeVal(a,v){var o=[];for(var i=0;i<a.length;i++)if(a[i]!==v)o.push(a[i]);return o;}function toolByName(n){for(var i=0;i<TOOLS.length;i++)if(TOOLS[i].name===n)return TOOLS[i];return null;}
function getReportRoot(){var fs=fso(),pref=join(ROOT,'Diagnostic-Reports');try{ensureFolder(pref);var p=join(pref,'.writetest.tmp'),x=fs.CreateTextFile(p,true);x.Write('ok');x.Close();fs.DeleteFile(p);return pref;}catch(e){var local=shell().ExpandEnvironmentStrings('%LOCALAPPDATA%')+'\\WindowsMasterDiagnosticToolkit\\Reports';try{ensureFolder(local);return local;}catch(e2){return shell().ExpandEnvironmentStrings('%TEMP%');}}}
function pad(n){return n<10?'0'+n:n;}function makeSession(){var d=new Date(),n=new ActiveXObject('WScript.Network').ComputerName;return n+'_'+d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'_'+pad(d.getHours())+pad(d.getMinutes())+pad(d.getSeconds());}
function init(){ROOT=dirname(normalizePath(document.location.pathname));REPORT=join(getReportRoot(),makeSession());try{ensureFolder(REPORT);}catch(e){}loadState();fillSystemInfo();currentTab=favorites.length?'favorites':'tools';setTab(currentTab);switchPlatform('windows');window.resizeTo(screen.availWidth,screen.availHeight);window.moveTo(0,0);}
function fillSystemInfo(){try{var net=new ActiveXObject('WScript.Network');document.getElementById('comp').innerText=net.ComputerName;document.getElementById('user').innerText=net.UserName;var svc=GetObject('winmgmts:{impersonationLevel=impersonate}!\\\\.\\root\\cimv2');var e=new Enumerator(svc.ExecQuery('select Caption from Win32_OperatingSystem'));if(!e.atEnd())document.getElementById('os').innerText=e.item().Caption;}catch(e){}document.getElementById('reportPath').innerText=REPORT;}
function switchPlatform(p){currentPlatform=p;document.getElementById('platWindows').className='plat'+(p==='windows'?' active':'');document.getElementById('platMac').className='plat'+(p==='mac'?' active':'');if(p==='mac'){showMacPlan();}else{hideMacPlan();render();}}
function showMacPlan(){document.getElementById('cards').style.display='none';document.getElementById('settingsPanel').style.display='none';document.getElementById('runbookPanel').style.display='none';document.getElementById('infoBar').style.display='none';document.getElementById('macPanel').style.display='block';document.getElementById('pageTitle').innerText='macOS Edition';document.getElementById('pageSub').innerText='Planning mode only - no Mac actions execute yet.';}
function hideMacPlan(){document.getElementById('macPanel').style.display='none';document.getElementById('cards').style.display='block';document.getElementById('infoBar').style.display='block';}
function setTab(t){if(currentPlatform!=='windows'){switchPlatform('windows');}currentTab=t;var ids=['favorites','tools','recent','runbook','settings'];for(var i=0;i<ids.length;i++){var el=document.getElementById('tab_'+ids[i]);if(el)el.className='tab'+(ids[i]===t?' active':'');}var ns=document.getElementsByClassName('nav');for(var j=0;j<ns.length;j++){var c=ns[j].getAttribute('data-cat');var active=(t==='favorites'&&c==='Favorites')||(t==='recent'&&c==='Recent')||(t==='runbook'&&c==='Runbook')||(t==='settings'&&c==='Settings');var sep=ns[j].className.indexOf('sep')>=0;ns[j].className=active?(sep?'nav sep active':'nav active'):(sep?'nav sep':'nav');}render();}
function setCat(c,el){if(currentPlatform!=='windows')switchPlatform('windows');currentCategory=c;var ns=document.getElementsByClassName('nav');for(var i=0;i<ns.length;i++){var dc=ns[i].getAttribute('data-cat'),sep=ns[i].className.indexOf('sep')>=0;ns[i].className=(dc===c)?(sep?'nav sep active':'nav active'):(sep?'nav sep':'nav');}currentTab='tools';setTabClasses('tools');render();}
function setTabClasses(active){var ids=['favorites','tools','recent','runbook','settings'];for(var i=0;i<ids.length;i++){var el=document.getElementById('tab_'+ids[i]);if(el)el.className='tab'+(ids[i]===active?' active':'');}}
function mapCat(t){if(t.category==='Diagnostics')return 'Diagnostics';if(t.category==='Security'||t.category==='BitLocker')return 'Security';if(t.category==='Network')return 'Network';if(t.category==='Storage')return 'Repair';if(t.category==='Updates')return 'Optimization';if(t.category==='Setup')return 'Deployment';if(t.category==='Advanced')return 'System Management';return t.category;}
function currentTools(){var q=(document.getElementById('search').value||'').toLowerCase(),a=[];if(currentTab==='favorites'){for(var i=0;i<favorites.length;i++){var f=toolByName(favorites[i]);if(f)a.push(f);}}else if(currentTab==='recent'){for(var j=0;j<recent.length;j++){var r=toolByName(recent[j]);if(r)a.push(r);}}else{a=TOOLS.slice(0);}var o=[];for(var k=0;k<a.length;k++){var t=a[k],mc=mapCat(t);if(currentTab==='tools'&&currentCategory!=='All Tools'&&mc!==currentCategory)continue;var hay=(t.name+' '+t.description+' '+t.category).toLowerCase();if(q&&hay.indexOf(q)<0)continue;o.push(t);}return o;}
function render(){if(currentPlatform!=='windows')return;var cards=document.getElementById('cards'),settings=document.getElementById('settingsPanel'),rb=document.getElementById('runbookPanel');cards.innerHTML='';cards.style.display='block';settings.style.display='none';rb.style.display='none';document.getElementById('infoBar').style.display='block';if(currentTab==='settings'){document.getElementById('pageTitle').innerText='Settings';document.getElementById('pageSub').innerText='Toolkit preferences, reports, platform planning and launch options.';cards.style.display='none';settings.style.display='block';return;}if(currentTab==='runbook'){document.getElementById('pageTitle').innerText='Runbook';document.getElementById('pageSub').innerText='Run the USB runbook inside the toolkit when available.';cards.style.display='none';document.getElementById('infoBar').style.display='none';rb.style.display='block';loadRunbook();return;}var a=currentTools(),title=currentTab==='favorites'?'Favorites':currentTab==='recent'?'Recent Tools':currentCategory;document.getElementById('pageTitle').innerText=title;document.getElementById('pageSub').innerText=currentTab==='tools'?'Select a tool to diagnose, repair, optimize, secure or deploy Windows systems.':'Your '+title.toLowerCase()+'.';if(a.length===0){cards.innerHTML='<div style="padding:40px;color:#5a7080;font-size:16px">No tools to display.</div>';return;}for(var i=0;i<a.length;i++)cards.appendChild(cardFor(a[i]));}
function cardFor(t){var d=document.createElement('div');d.className='card';d.onclick=function(){confirmRun(t);};var icon=document.createElement('div');icon.className='cardIcon';icon.innerHTML='<img src="Assets/Icons/'+t.icon+'.png">';d.appendChild(icon);var txt=document.createElement('div');txt.className='cardText';txt.innerHTML='<div class="cardTitle">'+html(t.name)+'</div><div class="cardDesc">'+html(t.description)+'</div>';d.appendChild(txt);var st=document.createElement('div');st.className='cardStar'+(has(favorites,t.name)?' on':'');st.innerHTML='&#9733;';st.title='Favorite';st.onclick=function(){if(window.event)window.event.cancelBubble=true;toggleFavorite(t.name);};d.appendChild(st);var risk=document.createElement('div');risk.className='cardRisk';risk.innerText=t.risk;d.appendChild(risk);return d;}
function toggleFavorite(n){if(has(favorites,n))favorites=removeVal(favorites,n);else favorites.unshift(n);saveState();render();}
function confirmRun(t){pendingTool=t;if(t.risk==='ReadOnly'){runTool(t);return;}document.getElementById('modalTitle').innerText=t.risk==='HighRisk'?'High-impact action':'Confirm system change';document.getElementById('modalText').innerText=t.name+'\n\n'+t.description+'\n\nThis tool can change the system or data. Continue?';document.getElementById('shade').style.display='block';}
function closeModal(){document.getElementById('shade').style.display='none';pendingTool=null;}function modalRun(){var t=pendingTool;closeModal();if(t)runTool(t);}function addRecent(n){recent=removeVal(recent,n);recent.unshift(n);if(recent.length>16)recent=recent.slice(0,16);saveState();}
function safeName(n){return n.replace(/[\\\/:*?"<>|]/g,'_');}
function showRunner(t,mode){document.getElementById('runner').style.display='block';document.getElementById('runnerTitle').innerText=t.name;document.getElementById('runnerMode').innerText=mode||'RUNNING';document.getElementById('runnerOut').innerText='Starting '+t.name+'...\r\n';runnerPct=8;document.getElementById('runnerBar').style.width=runnerPct+'%';}
function closeRunner(){document.getElementById('runner').style.display='none';}
function readTextFile(p){try{var fs=fso();if(!fs.FileExists(p))return '';var x=fs.OpenTextFile(p,1,false,-2),t=x.ReadAll();x.Close();return t;}catch(e){return '';}}
function readRunnerTextFile(p){try{var fs=fso();if(!fs.FileExists(p))return '';var x=fs.OpenTextFile(p,1,false,-1),t=x.ReadAll();x.Close();return t;}catch(e){return '';}}
function resolvePowerShell(){var fs=fso(),sh=shell(),win=sh.ExpandEnvironmentStrings('%WINDIR%');var sysnative=join(win,'Sysnative\\WindowsPowerShell\\v1.0\\powershell.exe');if(fs.FileExists(sysnative))return sysnative;var system32=join(win,'System32\\WindowsPowerShell\\v1.0\\powershell.exe');if(fs.FileExists(system32))return system32;return 'powershell.exe';}
function pollRunner(){try{var out=readRunnerTextFile(runnerLog),err=readRunnerTextFile(runnerErr),txt=out;if(err)txt+=(txt?'\r\n':'')+'--- STDERR ---\r\n'+err;if(txt)document.getElementById('runnerOut').innerText=txt;var box=document.getElementById('runnerOut');box.scrollTop=box.scrollHeight;if(runnerProc&&runnerProc.Status!==0){var code=runnerProc.ExitCode;runnerPct=100;document.getElementById('runnerBar').style.width='100%';document.getElementById('runnerMode').innerText=(code===0?'COMPLETE':'FAILED ('+code+')');document.getElementById('statusText').innerText=(code===0?'COMPLETED // ':'FAILED // ')+document.getElementById('runnerTitle').innerText.toUpperCase();runnerProc=null;runnerTimer=null;return;}runnerPct+=5;if(runnerPct>92)runnerPct=35;document.getElementById('runnerBar').style.width=runnerPct+'%';runnerTimer=setTimeout(pollRunner,500);}catch(e){document.getElementById('runnerOut').innerText+='\r\nRunner error: '+e.message;document.getElementById('runnerMode').innerText='RUNNER ERROR';runnerProc=null;runnerTimer=null;}}
function openCurrentLog(){if(runnerLog&&fso().FileExists(runnerLog))shell().Run('notepad.exe "'+runnerLog+'"',1,false);}
function quoteCmd(s){return '"'+String(s).replace(/"/g,'')+'"';}
function writeRunnerManifest(t,p){var fs=fso(),stamp=(new Date()).getTime(),manifest=join(REPORT,safeName(t.name)+'-'+stamp+'.runner.txt');var x=fs.CreateTextFile(manifest,true,true);x.WriteLine('ScriptPath='+p);x.WriteLine('ToolkitRoot='+ROOT);x.WriteLine('ReportDir='+REPORT);x.WriteLine('LogPath='+runnerLog);x.WriteLine('ErrorPath='+runnerErr);for(var i=0;i<t.args.length;i++)x.WriteLine('Arg='+String(t.args[i]).replace(/[\r\n]/g,''));x.Close();return manifest;}
function runTool(t){var p=join(ROOT,t.path),fs=fso();if(!fs.FileExists(p)){alert('Missing tool:\n'+p);return;}if(runnerProc&&runnerProc.Status===0){alert('Another tool is still running in the Run Center. Wait for it to finish before starting another tool.');return;}addRecent(t.name);document.getElementById('statusText').innerText='STARTING // '+t.name.toUpperCase();var ext=p.substr(p.lastIndexOf('.')).toLowerCase();if(ext==='.exe'||ext==='.msi'){shell().Run(quoteCmd(p),1,false);return;}var args='';for(var i=0;i<t.args.length;i++)args+=' '+quoteCmd(String(t.args[i]));if(t.interactive){showRunner(t,'INTERACTIVE WINDOW');document.getElementById('runnerOut').innerText='This workflow requires direct technician input. A temporary console or dialog is opening.\r\n\r\nThe main toolkit can remain open.';document.getElementById('runnerBar').style.width='25%';var ips=resolvePowerShell();var icmd=quoteCmd(ips)+' -NoLogo -NoProfile -STA -ExecutionPolicy Bypass -File '+quoteCmd(p)+args;shell().Run(icmd,1,false);return;}var stamp=(new Date()).getTime();runnerLog=join(REPORT,safeName(t.name)+'-'+stamp+'.log');runnerErr=join(REPORT,safeName(t.name)+'-'+stamp+'.err.log');try{if(fs.FileExists(runnerLog))fs.DeleteFile(runnerLog,true);if(fs.FileExists(runnerErr))fs.DeleteFile(runnerErr,true);}catch(e){}showRunner(t,'RUNNING IN APP');try{var runnerScript=join(ROOT,'App\\Invoke-ToolRunner.ps1');if(!fs.FileExists(runnerScript))throw new Error('App runner is missing: '+runnerScript);runnerManifest=writeRunnerManifest(t,p);var ps=resolvePowerShell();var cmd=quoteCmd(ps)+' -NoLogo -NoProfile -STA -WindowStyle Hidden -ExecutionPolicy Bypass -File '+quoteCmd(runnerScript)+' -ManifestPath '+quoteCmd(runnerManifest);runnerProc=shell().Exec(cmd);}catch(e){document.getElementById('runnerOut').innerText='Unable to launch tool: '+e.message;document.getElementById('runnerMode').innerText='LAUNCH FAILED';runnerProc=null;return;}if(runnerTimer)clearTimeout(runnerTimer);runnerTimer=setTimeout(pollRunner,250);}
function base64Unicode(s){var dom=new ActiveXObject('Microsoft.XMLDOM'),el=dom.createElement('b64'),stm=new ActiveXObject('ADODB.Stream');el.dataType='bin.base64';stm.Type=2;stm.Charset='unicode';stm.Open();stm.WriteText(s);stm.Position=0;stm.Type=1;el.nodeTypedValue=stm.Read();stm.Close();return el.text.replace(/\r|\n/g,'');}
function openReports(){shell().Run('explorer.exe "'+getReportRoot()+'"',1,false);}function openFolder(){shell().Run('explorer.exe "'+ROOT+'"',1,false);}function openClassic(){var p=join(ROOT,'START-TOOLKIT.cmd');if(fso().FileExists(p))shell().Run('"'+p+'"',1,false);}function installToolkit(){var p=join(ROOT,'INSTALL-WMDT.vbs');if(fso().FileExists(p))shell().Run('wscript.exe "'+p+'"',1,false);}
function isIgnoredRunbookPath(p){var r=('\\'+rbRel(p).toLowerCase().replace(/\//g,'\\')+'\\');var bad=['\\.venv\\','\\venv\\','\\env\\','\\site-packages\\','\\node_modules\\','\\__pycache__\\','\\.git\\','\\.github\\','\\dist\\','\\build\\','\\obj\\','\\bin\\','\\cache\\','\\migrations\\','\\staticfiles\\','\\media\\'];for(var i=0;i<bad.length;i++)if(r.indexOf(bad[i])>=0)return true;return false;}
function findRunbookRoot(){var fs=fso(),rootDrive=ROOT.length>=2?ROOT.substring(0,2):'',c=[];if(rootDrive)c.push(rootDrive+'\\runbook project');try{var drives=new Enumerator(fs.Drives);for(;!drives.atEnd();drives.moveNext()){var d=drives.item();if(d.IsReady)c.push(d.DriveLetter+':\\runbook project');}}catch(e){}c.push(join(ROOT,'Runbook'));for(var i=0;i<c.length;i++){try{if(fs.FolderExists(c[i]))return c[i];}catch(e){}}return '';}
function rbRel(p){if(runbookRoot&&p.toLowerCase().indexOf(runbookRoot.toLowerCase())===0){var r=p.substring(runbookRoot.length);while(r.charAt(0)==='\\')r=r.substring(1);return r;}return p;}
function walkDocs(folder,out,depth){if(depth>10)return;var fs=fso(),f;try{f=fs.GetFolder(folder);}catch(e){return;}var files=new Enumerator(f.Files);for(;!files.atEnd();files.moveNext()){var x=files.item(),ext=fs.GetExtensionName(x.Name).toLowerCase();if(!isIgnoredRunbookPath(x.Path)&&['html','htm','txt','md','rtf','pdf','doc','docx','xls','xlsx','csv','ppt','pptx'].indexOf(ext)>=0)out.push(x.Path);}var subs=new Enumerator(f.SubFolders);for(;!subs.atEnd();subs.moveNext()){var sf=subs.item();if(!isIgnoredRunbookPath(sf.Path))walkDocs(sf.Path,out,depth+1);}}
function rbCategory(p){var r=rbRel(p),i=r.indexOf('\\');return i>0?r.substring(0,i):'General';}
function rbSearchText(p){var fs=fso(),ext=fs.GetExtensionName(p).toLowerCase(),s=rbRel(p).toLowerCase();if(ext==='md'||ext==='txt'||ext==='htm'||ext==='html'||ext==='rtf'){var t=readTextFile(p);if(t.length>200000)t=t.substring(0,200000);s+=' '+t.toLowerCase();}return s;}
function renderRunbook(q){var list=document.getElementById('runbookList');list.innerHTML='';q=(q||'').toLowerCase();var groups={},n=0;for(var i=0;i<runbookIndex.length;i++){var p=runbookIndex[i];if(q&&rbSearchText(p).indexOf(q)<0)continue;var c=rbCategory(p);if(!groups[c])groups[c]=[];groups[c].push(p);n++;}var cats=[];for(var k in groups)if(groups.hasOwnProperty(k))cats.push(k);cats.sort();for(var j=0;j<cats.length;j++){var h=document.createElement('div');h.className='rbGroup';h.innerText=cats[j];list.appendChild(h);var arr=groups[cats[j]];arr.sort();for(var x=0;x<arr.length;x++){var d=document.createElement('div');d.className='rbItem';d.innerText=rbRel(arr[x]);d.title=arr[x];d.onclick=(function(path){return function(){viewRunbookFile(path);};})(arr[x]);list.appendChild(d);}}document.getElementById('runbookState').innerText='Runbook: '+runbookRoot+' | '+n+' document(s)'+(q?' matching search':'');}
function loadRunbook(){runbookRoot=findRunbookRoot();runbookIndex=[];var state=document.getElementById('runbookState');if(!runbookRoot){state.innerText='Runbook folder was not found. Expected: <USB drive>:\\runbook project';document.getElementById('runbookList').innerHTML='';return;}walkDocs(runbookRoot,runbookIndex,0);renderRunbook(document.getElementById('rbSearch').value);}
function searchRunbook(){renderRunbook(document.getElementById('rbSearch').value);}
function fileUrl(p){return 'file:///'+p.replace(/\\/g,'/').replace(/ /g,'%20');}
function viewRunbookFile(p){var fs=fso(),ext=fs.GetExtensionName(p).toLowerCase(),frame=document.getElementById('runbookFrame'),pre=document.getElementById('runbookText');if(ext==='html'||ext==='htm'||ext==='pdf'){pre.style.display='none';frame.style.display='block';frame.src=fileUrl(p);return;}if(ext==='md'||ext==='txt'||ext==='rtf'){frame.style.display='none';pre.style.display='block';pre.innerText=readTextFile(p);return;}frame.style.display='none';pre.style.display='block';pre.innerText='This document type opens in its registered Windows application.\r\n\r\n'+p+'\r\n\r\nDouble-click this document in the list again while holding CTRL, or use OPEN RUNBOOK FOLDER.';shell().Run(quoteCmd(p),1,false);}
function openRunbookFolder(){var p=findRunbookRoot();if(p)shell().Run('explorer.exe '+quoteCmd(p),1,false);else alert('Runbook folder not found.');}
function slugify(s){s=String(s||'').replace(/^\s+|\s+$/g,'').replace(/[\\\/:*?"<>|]/g,'-').replace(/\s+/g,'-');return s||'article';}
function newRunbookArticle(){if(!runbookRoot)runbookRoot=findRunbookRoot();if(!runbookRoot){alert('Runbook folder not found.');return;}var title=prompt('Article title:','');if(!title)return;var cat=prompt('Category / folder:','General');if(cat===null)return;cat=slugify(cat);var symptoms=prompt('Symptoms / issue summary:','');if(symptoms===null)return;var resolution=prompt('Resolution summary (you can edit the article afterward):','');if(resolution===null)return;var folder=join(join(runbookRoot,'Articles'),cat);ensureFolder(folder);var path=join(folder,slugify(title)+'.md');if(fso().FileExists(path)&&!confirm('Article already exists. Overwrite?'))return;var d=new Date(),body='# '+title+'\r\n\r\n**Category:** '+cat+'  \r\n**Platform:** Windows  \r\n**Status:** Draft  \r\n**Last Updated:** '+d.toLocaleDateString()+'  \r\n\r\n## Symptoms\r\n'+(symptoms||'Describe the symptoms.')+'\r\n\r\n## Applies To\r\nDescribe affected systems, versions, users, or environments.\r\n\r\n## Cause\r\nDocument the confirmed root cause when known.\r\n\r\n## Resolution\r\n'+(resolution||'Document the fix steps.')+'\r\n\r\n## Verification\r\nDocument how to prove the issue is resolved.\r\n\r\n## Rollback / Recovery\r\nDocument rollback steps when applicable.\r\n\r\n## Related Toolkit Tools\r\nList related T3CHNRD Digital Field Kit tools.\r\n\r\n## Notes / References\r\nAdd links, ticket references, screenshots, or related Runbook articles.\r\n';var x=fso().CreateTextFile(path,true,true);x.Write(body);x.Close();shell().Run('notepad.exe '+quoteCmd(path),1,false);loadRunbook();}
function importRunbookDocument(){if(!runbookRoot)runbookRoot=findRunbookRoot();if(!runbookRoot){alert('Runbook folder not found.');return;}var inp=document.getElementById('rbFile'),src=inp.value;if(!src){alert('Choose a document first.');return;}src=normalizePath(src);if(!fso().FileExists(src)){alert('Selected document was not found: '+src);return;}var fs=fso(),cat=prompt('Category / folder for this document:','General');if(cat===null)return;cat=slugify(cat);var ext=fs.GetExtensionName(src).toLowerCase(),editable=(ext==='md'||ext==='txt'||ext==='htm'||ext==='html'),destDir=editable?join(join(runbookRoot,'Articles'),cat):join(join(runbookRoot,'Attachments'),cat);ensureFolder(destDir);var dest=join(destDir,fs.GetFileName(src));if(fs.FileExists(dest)){if(!confirm('A document with this name already exists. Replace it?'))return;fs.DeleteFile(dest,true);}fs.CopyFile(src,dest,true);if(destDir.indexOf('Attachments')>=0){var title=fs.GetBaseName(src),articleDir=join(join(runbookRoot,'Articles'),slugify(cat));ensureFolder(articleDir);var wrapper=join(articleDir,slugify(title)+'.md'),rel=dest.substring(runbookRoot.length+1),body='# '+title+'\r\n\r\n**Category:** '+cat+'  \r\n**Status:** Reference Document  \r\n\r\n## Document\r\nImported attachment: `'+rel+'`\r\n\r\n## Notes\r\nAdd context describing when this document should be used.\r\n';var x=fs.CreateTextFile(wrapper,true,true);x.Write(body);x.Close();}inp.value='';loadRunbook();alert('Document added to the Runbook.');}
</script>
</head>
<body onload="init()">
<div id="shell">
<div id="header">
  <div id="logoOrb"><div class="pane p1"></div><div class="pane p2"></div><div class="pane p3"></div><div class="pane p4"></div></div>
  <div id="title">T3CHNRD Digital Field Kit</div><div id="tagline">Diagnose&nbsp;&nbsp;|&nbsp;&nbsp;Repair&nbsp;&nbsp;|&nbsp;&nbsp;Optimize&nbsp;&nbsp;|&nbsp;&nbsp;Deploy</div>
  <div id="brandNote">T3CHNRD Digital Field Kit&nbsp;&nbsp;v9<br><span class="small">Windows diagnostics | embedded run center | Runbook Wiki</span></div>
  <div id="platformSwitch"><span id="platWindows" class="plat active" onclick="switchPlatform('windows')">WINDOWS</span><span id="platMac" class="plat" onclick="switchPlatform('mac')">macOS</span></div>
  <div id="tabs"><span id="tab_favorites" class="tab" onclick="setTab('favorites')">FAVORITES</span><span id="tab_tools" class="tab" onclick="setTab('tools')">TOOLS</span><span id="tab_recent" class="tab" onclick="setTab('recent')">RECENT</span><span id="tab_runbook" class="tab" onclick="setTab('runbook')">RUNBOOK</span><span id="tab_settings" class="tab" onclick="setTab('settings')">SETTINGS</span></div>
  <div id="searchWrap"><input id="search" type="text" placeholder="Search tools..." onkeyup="render()"><span id="searchIcon">SEARCH</span></div>
</div>
<div id="body"><div id="sidebar">
  <div class="nav" data-cat="All Tools" onclick="setCat('All Tools',this)"><span class="nicon"><img src="Assets/Icons/gear.png"></span>All Tools</div>
  <div class="nav" data-cat="Diagnostics" onclick="setCat('Diagnostics',this)"><span class="nicon"><img src="Assets/Icons/monitor.png"></span>Diagnostics</div>
  <div class="nav" data-cat="Repair" onclick="setCat('Repair',this)"><span class="nicon"><img src="Assets/Icons/wrench.png"></span>Repair</div>
  <div class="nav" data-cat="Optimization" onclick="setCat('Optimization',this)"><span class="nicon"><img src="Assets/Icons/chart.png"></span>Optimization</div>
  <div class="nav" data-cat="Security" onclick="setCat('Security',this)"><span class="nicon"><img src="Assets/Icons/shield.png"></span>Security</div>
  <div class="nav" data-cat="Network" onclick="setCat('Network',this)"><span class="nicon"><img src="Assets/Icons/globe.png"></span>Network</div>
  <div class="nav" data-cat="Deployment" onclick="setCat('Deployment',this)"><span class="nicon"><img src="Assets/Icons/package.png"></span>Deployment</div>
  <div class="nav" data-cat="System Management" onclick="setCat('System Management',this)"><span class="nicon"><img src="Assets/Icons/gear.png"></span>System Management</div>
  <div class="nav sep" data-cat="Favorites" onclick="setTab('favorites')"><span class="nicon"><img src="Assets/Icons/star.png"></span>Favorites</div>
  <div class="nav" data-cat="Recent" onclick="setTab('recent')"><span class="nicon"><img src="Assets/Icons/document.png"></span>Recent</div>
  <div class="nav" data-cat="Runbook" onclick="setTab('runbook')"><span class="nicon"><img src="Assets/Icons/document.png"></span>Runbook</div>
  <div class="nav" data-cat="Settings" onclick="setTab('settings')"><span class="nicon"><img src="Assets/Icons/gear.png"></span>Settings</div>
</div>
<div id="main"><div id="pageTitle">Tools</div><div id="pageSub">Technician utilities.</div><div id="infoBar"><span id="infoDot">i</span><b>Select a tool to get started.</b><br>Normal tools run inside the app. A separate window is used only when direct technician input is unavoidable.</div><div id="cards"></div>
<div id="settingsPanel"><div class="settingsBox"><h2>Toolkit Settings</h2><p><b>Portable / Installed:</b> the same interface works from removable storage or an installed folder.</p><span class="actionBtn" onclick="openReports()">OPEN REPORTS</span><span class="actionBtn" onclick="openFolder()">TOOLKIT FOLDER</span><span class="actionBtn" onclick="openClassic()">CLASSIC CONSOLE</span><span class="actionBtn green" onclick="installToolkit()">INSTALL LOCALLY</span></div><div class="settingsBox"><h2>Platform Roadmap</h2><p>Use the Windows / macOS switch above. The macOS side is planning-only until its native collectors are implemented.</p></div></div>
<div id="runbookPanel"><div id="runbookToolbar"><span class="actionBtn green" onclick="loadRunbook()">REFRESH</span><span class="actionBtn" onclick="newRunbookArticle()">NEW ARTICLE</span><label class="actionBtn" style="position:relative;overflow:hidden">ADD DOCUMENT<input id="rbFile" type="file" onchange="importRunbookDocument()" style="position:absolute;left:-9999px"></label><span class="actionBtn" onclick="openRunbookFolder()">OPEN FOLDER</span><input id="rbSearch" type="text" placeholder="Search Runbook..." onkeyup="searchRunbook()"></div><div id="runbookState" class="runbookState">Looking for the portable Runbook...</div><div id="runbookList" class="runbookList"></div><div class="runbookViewer"><iframe id="runbookFrame"></iframe><pre id="runbookText" style="display:none"></pre></div></div>
<div id="macPanel"><div class="settingsBox"><h2>macOS Toolkit - Planning Mode</h2><p>This switch is a design placeholder for the future Mac edition. It does not execute Mac commands from Windows.</p></div><div class="macGrid"><div class="macCard"><b>System Information</b><span>system_profiler, hardware, OS, storage and battery inventory.</span><em class="planned">PLANNED</em></div><div class="macCard"><b>Performance</b><span>Activity Monitor/top, memory pressure and process diagnostics.</span><em class="planned">PLANNED</em></div><div class="macCard"><b>Crash Logs</b><span>DiagnosticReports and unified log collection.</span><em class="planned">PLANNED</em></div><div class="macCard"><b>Storage</b><span>diskutil, APFS, SMART and Disk Utility workflows.</span><em class="planned">PLANNED</em></div><div class="macCard"><b>Security</b><span>FileVault, Gatekeeper, XProtect and launch-item review.</span><em class="planned">PLANNED</em></div><div class="macCard"><b>Network</b><span>networksetup, scutil, route, DNS and Wi-Fi diagnostics.</span><em class="planned">PLANNED</em></div><div class="macCard"><b>Updates</b><span>softwareupdate and App Store/Homebrew-aware maintenance.</span><em class="planned">PLANNED</em></div><div class="macCard"><b>Persistence</b><span>launchctl, LaunchAgents, LaunchDaemons and login items.</span><em class="planned">PLANNED</em></div><div class="macCard"><b>Runbook</b><span>Reuse the same portable runbook content across Windows and macOS.</span><em class="planned">PLANNED</em></div></div></div>
</div></div>
<div id="footer"><div id="ready"><span class="readyDot">OK</span><span class="readyTxt"><b id="statusText">READY</b><span>Technician console</span></span></div><div id="sysInfo">Computer: <b id="comp"></b><br>OS: <span id="os">Windows</span> &nbsp;|&nbsp; User: <span id="user"></span></div><div id="footerRight">PORTABLE / INSTALLED<br>Reports: <span id="reportPath">session</span></div></div>
<div id="runner"><div id="runnerHead"><span id="runnerTitle">Tool</span><span id="runnerClose" onclick="closeRunner()">X</span><span class="runnerBtn" onclick="openCurrentLog()">OPEN LOG</span><span id="runnerMode" style="float:right;margin-right:14px;color:#b9df52">RUNNING</span></div><div class="runnerProgress"><div id="runnerBar"></div></div><pre id="runnerOut"></pre></div>
<div id="shade" class="modalShade"><div class="modal"><div id="modalTitle" class="modalHead">Confirm action</div><div id="modalText" class="modalBody"></div><div class="modalBtns"><button onclick="closeModal()">Cancel</button><button onclick="modalRun()">Continue</button></div></div></div>
</div>
</body>
</html>
